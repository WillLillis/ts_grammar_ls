grammar {
    language: "test",
    extras: [regexp(r"\s"), comment],
    word: identifier,
}

rule program { repeat(_statement) }

rule _statement { choice(expression, return_statement) }

rule expression { "x" }

rule return_statement { "return" }

rule identifier { regexp(r"[a-z]+") }

rule comment { token(seq("//", regexp("[^\n]*"))) }
