// Top-level comment
grammar {
    language: "test",
}

// Helper functions
fn commaSep1(item: rule_t) -> rule_t { seq(item, repeat(seq(",", item))) }
fn commaSep(item: rule_t) -> rule_t { optional(commaSep1(item)) }

// Rules
rule program { "x" }

// This is the identifier rule
rule identifier { regexp(r"[a-z]+") }
